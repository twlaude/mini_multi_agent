# Backend 전용 환경 변수. Host 실행·Docker(env_file) 공통.
# 컨테이너 안에서 달라지는 주소(OLLAMA_BASE_URL)는 compose.yml의 environment가 덮어쓴다.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
REQUEST_TIMEOUT_SECONDS=60
# 날씨 Tool: mock이면 고정 응답, real이면 Open-Meteo 실제 호출
WEATHER_MODE=mock
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
MAX_IMAGE_SIZE_MB=10
