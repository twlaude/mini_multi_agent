# cp .env.example .env 후 OPENAI_API_KEY만 채우면 됨 (상위 폴더 ../.env 키 그대로). 명령은 프로젝트 루트에서 실행.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
DATABASE_URL=postgresql://agent_user:agent_password@127.0.0.1:5432/multimodal_agent_db
REDIS_URL=redis://127.0.0.1:6379/0
BACKEND_URL=http://127.0.0.1:8000
MCP_URL=http://127.0.0.1:8020/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8020
RUN_TTL_SECONDS=300
RUN_TIMEOUT_SECONDS=600
MAX_TOOL_CALLS=12
MAX_UPLOAD_MB=10
MEDIA_STORAGE_DIR=storage
